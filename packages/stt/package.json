{
  "name": "@oat/stt",
  "version": "0.0.0",
  "private": true,
  "description": "Speech-to-text provider interface, Deepgram adapter and fake provider for tests.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./*.test": null
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "test:int": "vitest run --mode int --passWithNoTests"
  },
  "dependencies": {
    "@oat/audio": "workspace:*",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@oat/mocks": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
