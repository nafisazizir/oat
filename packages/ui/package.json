{
  "name": "@oat/ui",
  "version": "0.0.0",
  "private": true,
  "description": "shadcn/ui components and design tokens.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/tokens.css",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./*": "./src/*.ts",
    "./*.test": null
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "test:int": "vitest run --mode int --passWithNoTests",
    "gallery": "vite --config gallery/vite.config.ts",
    "gallery:build": "vite build --config gallery/vite.config.ts",
    "screenshots": "node gallery/screenshot.ts"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "catalog:",
    "@fontsource-variable/newsreader": "catalog:",
    "class-variance-authority": "catalog:",
    "cmdk": "catalog:",
    "next-themes": "catalog:",
    "react-resizable-panels": "catalog:",
    "sonner": "catalog:",
    "tw-animate-css": "catalog:",
    "@nafisazizir/ziiz": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "@base-ui/react": "catalog:",
    "@tabler/icons-react": "catalog:",
    "@shadcn/react": "catalog:",
    "input-otp": "catalog:",
    "react-day-picker": "catalog:",
    "date-fns": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
