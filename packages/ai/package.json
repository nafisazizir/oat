{
  "name": "@oat/ai",
  "version": "0.0.0",
  "private": true,
  "description": "Prompts, templates, tools and model config (Vercel AI SDK).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./*.test": null
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "test:int": "vitest run --mode int",
    "eval": "tsx evals/run.ts",
    "eval:baseline": "tsx evals/run.ts --update-baseline"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "catalog:",
    "@ai-sdk/provider": "catalog:",
    "@oat/core": "workspace:*",
    "ai": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@oat/mocks": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
