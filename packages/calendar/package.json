{
  "name": "@oat/calendar",
  "version": "0.0.0",
  "private": true,
  "description": "CalendarSource interface, CalendarCache, FixtureCalendarSource, mergeCalendarEvents; SidecarCalendarSource (Node entry) over `oat-audio calendar`; GoogleCalendarSource (`./google`) over the Google Calendar API.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./google": "./src/google/index.ts",
    "./*": "./src/*.ts",
    "./*.test": null
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "test:int": "vitest run --mode int --passWithNoTests"
  },
  "dependencies": {
    "@oat/audio": "workspace:*",
    "@oat/core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@oat/mocks": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
