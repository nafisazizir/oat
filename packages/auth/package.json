{
  "name": "@oat/auth",
  "version": "0.0.0",
  "private": true,
  "description": "Better Auth server config (magic link, Google via OIDC, organizations as workspaces, bearer), auth client and workspace helpers.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./access": "./src/access.ts",
    "./cookies": "./src/cookies.ts",
    "./*": "./src/*.ts",
    "./*.test": null
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "test:int": "vitest run --mode int"
  },
  "dependencies": {
    "@oat/core": "workspace:*",
    "@oat/db": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "nodemailer": "catalog:",
    "redis": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@oat/calendar": "workspace:*",
    "@oat/mocks": "workspace:*",
    "@oat/testkit": "workspace:*",
    "@types/node": "catalog:",
    "@types/nodemailer": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
