{
  "name": "@oat/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle schema (Postgres), migrations and shared row types.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./*.test": null
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "test:int": "vitest run --mode int",
    "test:perf": "OAT_SEARCH_PERF=1 vitest run --mode int --silent=false src/search.perf.int.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:seed": "tsx src/cli/seed.ts",
    "db:reset": "tsx src/cli/reset.ts",
    "db:studio": "drizzle-kit studio",
    "index:backfill": "pnpm --filter @oat/indexing backfill"
  },
  "dependencies": {
    "@oat/core": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@oat/testkit": "workspace:*",
    "@types/node": "catalog:",
    "better-auth": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
