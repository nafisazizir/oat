{
  "name": "@oat/audio",
  "version": "0.0.0",
  "private": true,
  "description": "AudioSource interface, FileSource, RecordingController, SidecarSource and the Ogg Opus audio archive (Node entry), WAV/level/resample utilities.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./*": "./src/*.ts",
    "./*.test": null
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "test:int": "vitest run --mode int --passWithNoTests",
    "build:sidecar": "cd ../../native/oat-audio && swift build -c release",
    "fixtures": "node scripts/make-fixtures.ts",
    "fixtures:check": "node scripts/make-fixtures.ts --check"
  },
  "dependencies": {
    "libopus-wasm": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
