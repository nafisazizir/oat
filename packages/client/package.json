{
  "name": "@oat/client",
  "version": "0.0.0",
  "private": true,
  "description": "Browser-safe typed Oat REST client with injectable transports.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./bridge": "./src/bridge.ts",
    "./routes": "./src/routes.ts",
    "./*.test": null
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "test:int": "vitest run --mode int --passWithNoTests"
  },
  "dependencies": {
    "@oat/core": "workspace:*",
    "@oat/services": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
