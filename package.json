{
  "name": "oat",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=!@oat/mocks",
    "dev:up": "node scripts/dev.mjs up",
    "dev:build": "node scripts/dev.mjs build",
    "dev:down": "node scripts/dev.mjs down",
    "dev:reset": "node scripts/dev.mjs reset",
    "dev:logs": "node scripts/dev.mjs logs",
    "dev:ps": "node scripts/dev.mjs ps",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "turbo run typecheck lint test && prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
