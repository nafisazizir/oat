{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": ["OAT_TEST_TIMEOUT_SCALE"],
  "globalDependencies": [
    "tsconfig.base.json",
    "eslint.config.js",
    "vitest.shared.ts",
    "fixtures/**"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@oat/client#test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/web/src/app/api/**/route.ts"],
      "outputs": []
    },
    "test:int": {
      "dependsOn": ["transit"],
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "BETTER_AUTH_*",
        "SMTP_*",
        "MAILPIT_URL",
        "MOCKS_URL",
        "AI_*",
        "DEEPGRAM_*",
        "OAUTH_*",
        "GOOGLE_CALENDAR_*",
        "NOTION_*",
        "OAT_*",
        "WORKFLOW_POSTGRES_*",
        "EVE_*"
      ]
    },
    "eval": {
      "dependsOn": ["transit"],
      "cache": false,
      "passThroughEnv": ["AI_*", "VERCEL", "VERCEL_OIDC_TOKEN", "MOCKS_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "BETTER_AUTH_*",
        "SMTP_*",
        "MAILPIT_URL",
        "MOCKS_URL",
        "AI_*",
        "DEEPGRAM_*",
        "OAUTH_*",
        "GOOGLE_CALENDAR_*",
        "NOTION_*",
        "OAT_*",
        "WORKFLOW_POSTGRES_*",
        "EVE_*"
      ]
    }
  }
}
