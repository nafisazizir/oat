{
  "name": "@oat/web",
  "version": "0.0.0",
  "private": true,
  "description": "Oat web app: Next.js App Router (workspace UI, API, auth, share viewer).",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "test:int": "vitest run --mode int --passWithNoTests",
    "e2e": "playwright test",
    "e2e:screenshots": "E2E_SCREENSHOTS=1 playwright test screenshots",
    "e2e:prod": "OAT_E2E_PROD=1 OAT_NEXT_DIST_DIR=.next-e2e-prod playwright test share-csp"
  },
