    "@oat/db": "workspace:*",
    "@oat/editor": "workspace:*",
    "@oat/indexing": "workspace:*",
    "@oat/integrations-notion": "workspace:*",
    "@oat/meeting-ui": "workspace:*",
    "@oat/services": "workspace:*",
    "@oat/stt": "workspace:*",
    "@oat/ui": "workspace:*",
    "@tabler/icons-react": "catalog:",
    "ai": "catalog:",
    "cmdk": "catalog:",
    "drizzle-orm": "catalog:",
    "markdown-it": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
