# Oat environment. `pnpm dev:up` copies this to `.env` if it doesn't exist.
# Defaults point at the local compose stack (D-11, docs/DEV.md): no keys, no external calls.
# To use a real provider, fill in its key (and base URL if needed) in `.env`; nothing else changes.

# --- Postgres (stands in for Neon in prod) -----------------------------------------------------------
DATABASE_URL=postgres://oat:oat@localhost:54329/oat
# Superuser connection @oat/testkit uses to create/drop throwaway oat_test_* databases.
# Optional: derived from DATABASE_URL (same server, `postgres` database) when unset.
OAT_DATABASE_ADMIN_URL=postgres://oat:oat@localhost:54329/postgres

# --- Redis (stands in for Upstash / managed Redis: queues, rate limits, pub/sub) ----------------------
# Also backs the per-email magic-link send limit (rediss:// for TLS).
REDIS_URL=redis://localhost:63790
# Rate limits key on the client IP. Trust X-Vercel-Forwarded-For / X-Real-IP / the first X-Forwarded-For hop
# only behind a proxy that overwrites them: 1/0, blank = trusted only on Vercel (VERCEL set). Untrusted: the
# last X-Forwarded-For hop (the socket address Next.js records, or what your reverse proxy appended).
TRUST_PROXY_HEADERS=

# --- Auth (Better Auth) -------------------------------------------------------------------------------
# Signs session cookies and tokens. Dev-only value: a production deployment on a non-localhost URL refuses
# it (and plain-http URLs). Generate one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=oat-dev-secret-not-for-production-0123456789
# Public origin of the web app; magic links and OAuth callbacks point here.
BETTER_AUTH_URL=http://localhost:3000
# Optional extra origins allowed to call /api/auth (comma-separated). The URL above is always trusted.
BETTER_AUTH_TRUSTED_ORIGINS=
# Most team workspaces one user may create (blank = 20).
AUTH_MAX_TEAM_WORKSPACES=
# Desktop app (dev builds only): origin of apps/web it signs in against and calls. Blank = BETTER_AUTH_URL.
# A packaged app ignores it (its URL is built in).
OAT_WEB_URL=
# Web /desktop/sign-in: "Copy link for the app" fallback (for a dev app the browser can't hand oat:// links
# to). Blank = on outside production; 0 = off. Never in production (1 is refused there).
OAT_DESKTOP_DEV_HANDOFF=

# --- Email (Mailpit stands in for the transactional email provider) ----------------------------------
SMTP_HOST=localhost
SMTP_PORT=11025
# Mailpit accepts any credentials; leave blank locally.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Oat <no-reply@oat.localhost>"
# Mailpit web UI + REST API (dev/test only; read sent mail here).
MAILPIT_URL=http://localhost:18025

# --- Google OAuth / OIDC (mock-oauth2-server stands in for accounts.google.com) ----------------------
# Real Google: OAUTH_GOOGLE_ISSUER=https://accounts.google.com plus a real client id/secret.
OAUTH_GOOGLE_ISSUER=http://localhost:18089/google
# The mock accepts any client id/secret; these are placeholders.
OAUTH_GOOGLE_CLIENT_ID=oat-dev
OAUTH_GOOGLE_CLIENT_SECRET=oat-dev-secret
# Google Calendar API ("Connect Google Calendar", same OAuth client; scope calendar.readonly). Blank = derived:
# https://www.googleapis.com when OAUTH_GOOGLE_ISSUER is accounts.google.com, else the mock at ${MOCKS_URL}/gcal.
GOOGLE_CALENDAR_BASE_URL=

# --- Mocks service (tools/mocks: LLM, STT, Notion, Google Calendar stand-ins) ------------------------
MOCKS_URL=http://localhost:14010

# --- AI (Vercel AI Gateway) ---------------------------------------------------------------------------
# Blank = use the OpenAI-compatible mock LLM (see AI_BASE_URL). Set the key to use the real AI Gateway.
AI_GATEWAY_API_KEY=
# Optional AI Gateway URL override (only used when the key is set; blank = the gateway's default).
AI_GATEWAY_BASE_URL=
# OpenAI-compatible endpoint used when there is no key. Blank = ${MOCKS_URL}/llm/v1
# (http://localhost:14010/llm/v1).
AI_BASE_URL=
# Per-role model overrides, as AI Gateway "provider/model" ids. Blank = the defaults in packages/ai/src/models.ts.
AI_MODEL_ENHANCE=
AI_MODEL_CHAT=
AI_MODEL_FAST=
# Grader for `pnpm --filter @oat/ai eval --model real` (default: a different provider than AI_MODEL_ENHANCE).
AI_MODEL_JUDGE=
# Must produce 1536-dimensional vectors (EMBEDDING_DIMENSIONS) or retrieval breaks.
AI_MODEL_EMBED=

# --- Speech-to-text (Deepgram) ------------------------------------------------------------------------
# Blank = use the Deepgram-compatible mock at ${MOCKS_URL}/stt (live socket ws://localhost:14010/stt/v1/listen,
# token grant POST /stt/v1/auth/grant). Set the key to use real Deepgram. Server-side only: clients never get
# the key, they get short-lived tokens minted with it (D-17). Also enables the @oat/stt smoke test.
DEEPGRAM_API_KEY=
# Optional base URL override (blank = api.deepgram.com when a key is set, else the mock). @oat/stt derives
# `<base>/v1/listen` (http→ws) and `<base>/v1/auth/grant` from it (resolveDeepgramEndpoints).
DEEPGRAM_BASE_URL=
