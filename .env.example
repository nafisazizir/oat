# Oat environment. `pnpm dev:up` copies this to `.env` if it doesn't exist.
# Defaults point at the local compose stack (D-11, docs/DEV.md): no keys, no external calls.
# To use a real provider, fill in its key (and base URL if needed) in `.env`; nothing else changes.

# --- Postgres (stands in for Neon in prod) -----------------------------------------------------------
DATABASE_URL=postgres://oat:oat@localhost:54329/oat
# Superuser connection @oat/testkit uses to create/drop throwaway oat_test_* databases.
# Optional: derived from DATABASE_URL (same server, `postgres` database) when unset.
OAT_DATABASE_ADMIN_URL=postgres://oat:oat@localhost:54329/postgres

# --- Redis (stands in for Upstash / managed Redis: queues, rate limits, pub/sub) ----------------------
REDIS_URL=redis://localhost:63790

# --- Email (Mailpit stands in for the transactional email provider) ----------------------------------
SMTP_HOST=localhost
SMTP_PORT=11025
# Mailpit accepts any credentials; leave blank locally.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Oat <no-reply@oat.localhost>"
# Mailpit web UI + REST API (dev/test only; read sent mail here).
MAILPIT_URL=http://localhost:18025

# --- Google OAuth / OIDC (mock-oauth2-server stands in for accounts.google.com) ----------------------
# Real Google: OAUTH_GOOGLE_ISSUER=https://accounts.google.com plus a real client id/secret.
OAUTH_GOOGLE_ISSUER=http://localhost:18089/google
# The mock accepts any client id/secret; these are placeholders.
OAUTH_GOOGLE_CLIENT_ID=oat-dev
OAUTH_GOOGLE_CLIENT_SECRET=oat-dev-secret

# --- Mocks service (tools/mocks: LLM, STT, Notion, Google Calendar stand-ins) ------------------------
MOCKS_URL=http://localhost:14010

# --- AI (Vercel AI Gateway) ---------------------------------------------------------------------------
# Blank = use the OpenAI-compatible mock LLM (see AI_BASE_URL). Set the key to use the real AI Gateway.
AI_GATEWAY_API_KEY=
# Optional AI Gateway URL override (only used when the key is set; blank = the gateway's default).
AI_GATEWAY_BASE_URL=
# OpenAI-compatible endpoint used when there is no key. Blank = ${MOCKS_URL}/llm/v1
# (http://localhost:14010/llm/v1).
AI_BASE_URL=
# Per-role model overrides, as AI Gateway "provider/model" ids. Blank = the defaults in packages/ai/src/models.ts.
AI_MODEL_ENHANCE=
AI_MODEL_CHAT=
AI_MODEL_FAST=
# Must produce 1536-dimensional vectors (EMBEDDING_DIMENSIONS) or retrieval breaks.
AI_MODEL_EMBED=

# --- Speech-to-text (Deepgram) ------------------------------------------------------------------------
# Blank = use the Deepgram-compatible mock at ${MOCKS_URL}/stt. Set the key to use real Deepgram.
DEEPGRAM_API_KEY=
# Optional base URL override (blank = api.deepgram.com when a key is set, else the mock).
DEEPGRAM_BASE_URL=
